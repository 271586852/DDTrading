TUSHARE_TOKEN=your_tushare_token_here
# Tushare 常见限额：500 次/分钟（可改小以更保守，不可超过 500）
DDTRADING_TUSHARE_MAX_REQUESTS_PER_MINUTE=500
DDTRADING_TUSHARE_UNIVERSE_SIZE=300
DDTRADING_TUSHARE_MAX_WORKERS=8
DDTRADING_TUSHARE_DAILY_PARQUET_PATH=./data/tushare_daily.parquet
DDTRADING_DAILY_HISTORY_DAYS=7000
DDTRADING_DAILY_CACHE_TTL_HOURS=24
# 全市场 /refresh 成功后多少小时内跳过重复刷新（0=不启用；单股/回测内部补数会 force 绕过）
DDTRADING_MARKET_REFRESH_COOLDOWN_HOURS=24
DDTRADING_CORS_ORIGINS=http://127.0.0.1:3010,http://localhost:3010